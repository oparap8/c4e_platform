   "fieldtype": "Small Text",
   "label": "Solution",
   "placeholder": "A mobile app that lets sellers create payment links for orders and automatically send reminders if customers haven't paid after 24 hours."
  },
  {
   "fieldname": "why_now_tab",
   "fieldtype": "Tab Break",
   "label": "Why Now"
  },
  {
   "description": "Why is this the right time to build this? Something has recently changed \u2014 in technology, behaviour, regulation, or the market \u2014 that makes this possible or urgent.",
   "fieldname": "why_now",
   "fieldtype": "Small Text",
   "label": "Why Now",
   "placeholder": "Mobile money use in Rwanda has doubled since 2020. Sellers use phones for payments, but tools to manage their business are missing."
  },
  {
   "fieldname": "market_potential_tab",
   "fieldtype": "Tab Break",
   "label": "Market Potential"
  },
  {
