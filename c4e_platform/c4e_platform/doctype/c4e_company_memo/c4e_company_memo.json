  {
   "fieldname": "problem_tab",
   "fieldtype": "Tab Break",
   "label": "Problem"
  },
  {
   "description": "Describe the problem your customers face. Be specific \u2014 what happens, how often, and what it costs them.\n",
   "fieldname": "problem",
   "fieldtype": "Small Text",
   "label": "Problem",
   "placeholder": "e.g. Sellers take WhatsApp orders but struggle to track payments. They spend hours chasing customers and risk delivering without payment."
  },
  {
   "fieldname": "solution_tab",
   "fieldtype": "Tab Break",
   "label": "Solution"
  },
  {
