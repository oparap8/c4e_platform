   "fieldtype": "Small Text",
   "label": "Market Potential",
   "placeholder": "e.g Kigali has ~80,000 informal sellers (RDB 2023). Around half take orders on WhatsApp. That\u2019s our starting market."
  },
  {
   "fieldname": "competition_tab",
   "fieldtype": "Tab Break",
   "label": "Competition"
  },
  {
